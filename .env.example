# The app does not load a .env file. Export these in your shell, or prefix the
# command: ANTHROPIC_API_KEY=... npm start
# Everything else (translator choice, model, Ollama endpoint and model) is set in
# Settings and stored in ~/.vsm-translator/config.json.

# Optional. Enables the Claude translator. Overrides a key saved in Settings.
# Without it the app starts on the built-in offline translator.
ANTHROPIC_API_KEY=
